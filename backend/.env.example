# ─────────────────────────────────────────────────────────────────────────────
# MyAuto Backend — Environment Configuration Example (.env.example)
# Copy this file to .env and configure for your local/server environment.
# NEVER commit real credentials, production passwords, or keys to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application Runtime ───────────────────────────────────────────────────────
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8919
LOG_LEVEL=info

# ── PostgreSQL / PostGIS ──────────────────────────────────────────────────────
# Async SQLAlchemy connection URL (used at runtime)
DATABASE_URL=postgresql+asyncpg://myauto:password@postgres:5432/myauto
# Synchronous connection URL (used by Alembic migrations)
DATABASE_SYNC_URL=postgresql://myauto:password@postgres:5432/myauto

# ── External Open-Source Services ─────────────────────────────────────────────
# Photon Geocoding Engine
PHOTON_URL=http://photon:2322
PHOTON_TIMEOUT_SECONDS=5.0

# Valhalla Routing Engine
VALHALLA_URL=http://valhalla:8002
VALHALLA_TIMEOUT_SECONDS=8.0

# ── Feature Flags (All False by default for safe fallback) ───────────────────
# Enable PostgreSQL persistence (when false, client uses Firebase / mock mode)
ENABLE_POSTGRES=false

# Enable Valhalla routing (when false, route endpoint returns 503 disabled)
ENABLE_VALHALLA=false

# Enable Firebase Auth ID token verification
ENABLE_FIREBASE_AUTH=false

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Runtime mounted service account JSON (never baked into Docker images)
FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=myauto-dd21e

# ── Redis (Optional caching & presence) ───────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Security & CORS ───────────────────────────────────────────────────────────
# Comma-separated allowed origins (leave empty for '*' in development)
CORS_ORIGINS=
