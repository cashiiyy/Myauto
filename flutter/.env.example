# Flutter Environment Variables (dart-define)
# Do not commit the actual .env file. Use this as a template.

# Backend HTTP Base URL (FastAPI)
# For local emulator testing against local backend: http://10.0.2.2:8000
# For Tailscale dev: http://100.89.251.123:8000
BACKEND_URL=http://100.89.251.123:8000

# Backend WebSocket URL
# For local emulator testing: ws://10.0.2.2:8000/ws
# For Tailscale dev: ws://100.89.251.123:8000/ws
BACKEND_WS_URL=ws://100.89.251.123:8000/ws

# Mock Mode
# If true, network calls to the backend are bypassed and mock data is returned.
# Useful for UI development without a running backend.
MOCK_MODE=false
