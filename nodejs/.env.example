# ─────────────────────────────────────────────────────────────────────────────
# MyAuto Socket.IO Server — Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
APP_ENV=development

# ── Database (shared with FastAPI backend) ────────────────────────────────────
DATABASE_URL=postgresql://myauto:CHANGE_ME_strong_password_here@localhost:5432/myauto

# ── Redis (optional — reserved for future presence pubsub) ────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Path to Firebase service account JSON (relative to nodejs directory)
FIREBASE_SERVICE_ACCOUNT_PATH=../backend/secrets/serviceAccountKey.json
FIREBASE_PROJECT_ID=myauto-493fc

# ── Security ──────────────────────────────────────────────────────────────────
# CORS origins (comma-separated). Leave empty to allow all origins in dev.
CORS_ORIGINS=

# ── Matching / Search Radii (kilometres) ──────────────────────────────────────
INITIAL_RADIUS_KM=2.0
FALLBACK_RADIUS_KM=5.0

# ── Location Freshness (seconds) ──────────────────────────────────────────────
FRESHNESS_STALE_SECONDS=30
