# ─────────────────────────────────────────────────────────────────────────────
# MyAuto Flutter App — dart-define Environment Variables Reference
# ─────────────────────────────────────────────────────────────────────────────
# These are NOT loaded automatically. They must be passed via --dart-define
# flags when running or building the Flutter app.
#
# Usage:
#   flutter run \
#     --dart-define=BACKEND_URL=http://10.0.2.2:8919 \
#     --dart-define=BACKEND_WS_URL=ws://10.0.2.2:8919/ws
#
# Or create a run configuration in Android Studio / VS Code with these values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Existing backend (FastAPI on port 8919) ───────────────────────────────────
# Android emulator → host: 10.0.2.2
# Physical device on LAN: use your machine's LAN IP (e.g. 192.168.1.x)
# Tailscale: use the Tailscale IP (e.g. 100.89.251.123)
BACKEND_URL=http://10.0.2.2:8919
BACKEND_WS_URL=ws://10.0.2.2:8919/ws

# ── Mock mode (offline UI development — skips all backend calls) ──────────────
MOCK_MODE=false

# ── Map rendering mode ────────────────────────────────────────────────────────
# 'flutter_map' (default) — existing flutter_map + OSM tiles (no change)
# 'maplibre'              — MapLibre GL vector tiles (requires maplibre_gl dep)
MAP_MODE=flutter_map

# OSM raster tile URL (used by flutter_map and as MapLibre fallback)
# Default uses OpenStreetMap — change to a self-hosted tile server for production
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# MapLibre style JSON URL (only used when MAP_MODE=maplibre)
# Dev default: OpenFreeMap Liberty style (no API key required)
# Prod: self-hosted style server, e.g. https://tiles.yourdomain.com/styles/osm/style.json
MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# ── Real-time transport mode ──────────────────────────────────────────────────
# 'websocket' (default) — existing FastAPI WebSocket (BackendWebSocketClient)
# 'socketio'            — new Node.js Socket.IO server on port 3001
# 'mock'                — mock events for fully offline development
REALTIME_MODE=websocket

# Node.js Socket.IO server URL (only used when REALTIME_MODE=socketio)
# Android emulator → host: 10.0.2.2:3001
# Physical device: <LAN_IP>:3001  or  <Tailscale_IP>:3001
SOCKETIO_URL=http://10.0.2.2:3001

# ── Geocoding — Photon (passenger destination search only) ────────────────────
# Dev: use the free public photon.komoot.io endpoint (rate-limited, no key required)
# Prod: self-hosted Photon on port 2322, e.g. http://<server>:2322
PHOTON_URL=https://photon.komoot.io

# Bounding box for geocoding bias (minLon,minLat,maxLon,maxLat)
# Default: Kollam district
PHOTON_BBOX=76.35,8.70,76.85,9.10

# ── Routing — Valhalla (route + ETA calculation) ──────────────────────────────
# Dev: use the free public Valhalla demo endpoint
# Prod: self-hosted Valhalla on port 8002, e.g. http://<server>:8002
VALHALLA_URL=https://valhalla1.openstreetmap.de

# Valhalla costing profile ('auto' for general auto-rickshaws, 'motorcycle' for narrower roads)
VALHALLA_COSTING=auto

# ── Physical Device Testing via Tailscale ─────────────────────────────────────
# When testing on a physical phone connected over Tailscale VPN:
# 1. Start Docker backend: `docker compose up -d`
# 2. Get your computer's Tailscale IP (e.g. 100.89.251.123)
# 3. Run on physical device:
#      flutter run \
#        --dart-define=BACKEND_URL=http://100.89.251.123:8919 \
#        --dart-define=BACKEND_WS_URL=ws://100.89.251.123:8919/ws \
#        --dart-define=SOCKETIO_URL=http://100.89.251.123:3001
# ─────────────────────────────────────────────────────────────────────────────
