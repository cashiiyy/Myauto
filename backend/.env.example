# ─────────────────────────────────────────────────────────────────────────────
# MyAuto Backend — Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info

# ── Database (PostgreSQL + PostGIS) ───────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=myauto
POSTGRES_USER=myauto
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
DATABASE_URL=postgresql+asyncpg://myauto:CHANGE_ME_strong_password_here@postgres:5432/myauto
DATABASE_SYNC_URL=postgresql://myauto:CHANGE_ME_strong_password_here@postgres:5432/myauto

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
# REDIS_PASSWORD=CHANGE_ME  # uncomment if Redis auth is enabled

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Path to Firebase service account JSON (relative to backend/ directory)
# Download from: Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/serviceAccountKey.json
FIREBASE_PROJECT_ID=myauto-493fc

# ── Security ──────────────────────────────────────────────────────────────────
# CORS origins (comma-separated, no trailing slashes)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Rate limiting: requests per minute per IP
RATE_LIMIT_PER_MINUTE=60
# Maximum request payload size in bytes (1MB default)
MAX_PAYLOAD_BYTES=1048576

# ── Location Quality Thresholds ───────────────────────────────────────────────
# GPS accuracy in metres: anything above this is rejected for matching
MAX_MATCH_ACCURACY_METERS=100.0
# High confidence threshold (metres)
ACCURACY_HIGH_CONFIDENCE_METERS=25.0
# Acceptable threshold (metres)
ACCURACY_ACCEPTABLE_METERS=50.0

# Maximum age of a GPS fix allowed for matching (seconds)
MAX_MATCH_AGE_SECONDS=30

# Maximum speed that is considered plausible for an auto-rickshaw (m/s)
# ~72 km/h = 20 m/s  (generous upper bound)
MAX_SPEED_MPS=20.0

# ── Location Freshness Thresholds (seconds) ───────────────────────────────────
FRESHNESS_LIVE_SECONDS=5
FRESHNESS_DELAYED_SECONDS=15
FRESHNESS_STALE_SECONDS=30
# After STALE_SECONDS, driver is considered OFFLINE for matching

# ── Redis TTLs (seconds) ──────────────────────────────────────────────────────
# How long a driver's live location is kept in Redis
LIVE_LOCATION_TTL_SECONDS=30
# How long a driver's presence record is kept (slightly longer than location)
DRIVER_PRESENCE_TTL_SECONDS=35
# How long a passenger's location is kept
PASSENGER_LOCATION_TTL_SECONDS=60
# How long a ride session is kept in Redis
RIDE_SESSION_TTL_SECONDS=3600
# How long a rejection record is kept
RIDE_REJECTED_TTL_SECONDS=600
# How long an atomic driver lock is held (seconds)
DRIVER_LOCK_TTL_SECONDS=10

# ── Matching / Search Radii (kilometres) ──────────────────────────────────────
INITIAL_RADIUS_KM=2.0
FALLBACK_RADIUS_KM=5.0
MAX_RADIUS_KM=10.0

# ── Ride Timeouts ─────────────────────────────────────────────────────────────
# How long a driver has to respond to a ride request before timeout (seconds)
DRIVER_RESPONSE_TIMEOUT_SECONDS=30
# How long a ride request stays open before expiring (seconds)
RIDE_REQUEST_EXPIRES_SECONDS=120

# ── WebSocket ─────────────────────────────────────────────────────────────────
# Interval between server heartbeat pings (seconds)
WS_HEARTBEAT_INTERVAL_SECONDS=20
# Time to wait for a pong before declaring the connection dead (seconds)
WS_PONG_TIMEOUT_SECONDS=10
